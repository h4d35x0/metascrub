<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        No permissions are declared, and that is a design statement rather than
        an omission. Every file this app touches arrives as a URI grant the user
        chose: from the share intent, or from ACTION_OPEN_DOCUMENT when they pick
        files here. Output goes through ACTION_CREATE_DOCUMENT or a folder grant
        from ACTION_OPEN_DOCUMENT_TREE. None of that needs a permission.

        Adding READ_MEDIA_IMAGES would let the app enumerate the whole gallery in
        order to read the one file the user already pointed at. For a tool whose
        purpose is not leaking things, that is the wrong trade, and it would put
        a permission prompt in front of a first run that does not need one.

        There is no INTERNET permission either, so nothing it reads can leave the
        device.

        Verified against a running build 2026-09-07: the OS reports no media or
        storage permission requested by this package.
    -->

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_menu_delete"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light">

        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:label="@string/share_label">

            <!--
                The flow that matters: gallery, Share, metascrub, on to the
                destination app. An app you have to open and navigate to find a
                file does not get used at the moment it matters.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>

            <!--
                SEND_MULTIPLE is a separate action, not a variant of SEND, and an
                app that declares only SEND simply does not appear in the share
                sheet once you select a second photo. Added 2026-09-07 alongside
                in-app multi-select, because offering batches in one entry point
                and not the other is a difference nobody would predict.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>

            <!--
                The launcher entry is a real entry point, not a diagnostics
                screen. Until 2026-09-07 it said "share a photo to this app" and
                offered no way to do anything, which is a dead end: the icon is
                the first thing anyone taps. It now opens the system file picker.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The cleaned file is handed on as a content:// URI with a read grant
            scoped to the receiving app, never as a file:// path. The receiving
            app therefore gets the scrubbed copy and no access to anything else.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
